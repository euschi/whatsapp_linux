# Maintainer: Eugenio Schintu <eugenio.schintu@simultech.it>
pkgname=whatsapp-linux
pkgver=1.0.0
pkgrel=1
pkgdesc='Unofficial WhatsApp desktop client (WhatsApp Web wrapper) with tray, notifications, voice and video calls'
arch=('any')
url='https://github.com/euschi/whatsapp_linux'
license=('MIT')
_electron=electron44
depends=("$_electron" 'libnotify' 'xdg-desktop-portal' 'pipewire' 'hicolor-icon-theme')
optdepends=(
  'libappindicator-gtk3: system tray icon'
  'gnome-shell-extension-appindicator: system tray icon on GNOME'
  'hunspell-it: Italian spell checking'
)
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('af2f1e31ce8541176f6c9fc22956d737df8f4c343bf7d940eb2af1a79045c15a')

package() {
  cd "whatsapp_linux-$pkgver"

  install -d "$pkgdir/usr/lib/$pkgname/assets/icons"
  cp -r src package.json "$pkgdir/usr/lib/$pkgname/"
  install -m644 assets/icons/*.png "$pkgdir/usr/lib/$pkgname/assets/icons/"

  sed "s/electron44/$_electron/" packaging/whatsapp-linux.sh > "$srcdir/launcher"
  install -Dm755 "$srcdir/launcher" "$pkgdir/usr/bin/$pkgname"
  install -Dm644 packaging/whatsapp-linux.desktop "$pkgdir/usr/share/applications/$pkgname.desktop"

  for s in 16 22 24 32 48 64 128 256 512; do
    install -Dm644 "assets/icons/app-$s.png" "$pkgdir/usr/share/icons/hicolor/${s}x${s}/apps/$pkgname.png"
  done
  install -Dm644 assets/icons/app.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/$pkgname.svg"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
